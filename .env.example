# Hub environment. Copy to .env and fill in. Never commit .env.
# Every backend process reads this file from the repo root (packages/server/src/env.ts).

# ---- Runtime ----
# Required: development | test | production. There is no default, so an unset NODE_ENV can
# never silently disable the production guards; every backend process refuses to start
# without it. Vitest sets `test` itself. With NODE_ENV=production, startup also fails on
# the default SESSION_SECRET, DEV_AUTH, GMAIL_FAKE, PUSH_FAKE, MODEL_PROVIDER=fake or
# SECRETS_PROVIDER=local.
NODE_ENV=development
# pino level: trace | debug | info | warn | error
LOG_LEVEL=info

# ---- Datastores (docker compose maps Postgres to 5434 and Redis to 6380) ----
DATABASE_URL=postgres://hub:hub@localhost:5434/hub
REDIS_URL=redis://localhost:6380
# Admin connection used by tests to create throwaway databases.
TEST_DATABASE_URL=postgres://hub:hub@localhost:5434/hub

# ---- Service ports and public URLs ----
API_PORT=4000
GATEWAY_PORT=4001
MCP_PORT=4002
# URL the phone uses to reach the API. On a device, use your LAN IP or tunnel URL.
PUBLIC_API_URL=http://localhost:4000
# Public URL of the gateway. Pub/Sub push must reach it, so use a tunnel in dev
# (e.g. `cloudflared tunnel --url http://localhost:4001`).
PUBLIC_GATEWAY_URL=http://localhost:4001
# URL MCP clients connect to (shown on the Agents screen).
PUBLIC_MCP_URL=http://localhost:4002/mcp
# Deep-link scheme of the mobile app (app.json "scheme").
APP_SCHEME=hub

# ---- App auth ----
# Signs OAuth state and other short-lived tokens. 32+ random chars: `openssl rand -base64 48`
SESSION_SECRET=
# 1 enables POST /auth/dev (email-only sign-in). Development only; ignored in production.
DEV_AUTH=1

# ---- Secrets at rest (envelope encryption) ----
# local = wrap data keys with LOCAL_MASTER_KEY (dev only). kms = AWS KMS (production).
SECRETS_PROVIDER=local
# 32 random bytes, base64: `openssl rand -base64 32`
LOCAL_MASTER_KEY=
# Required when SECRETS_PROVIDER=kms. Key ARN or alias; AWS credentials come from the usual chain.
KMS_KEY_ID=
# Write-scope tokens (kinds ending ":write", e.g. gmail.send) are sealed with a SEPARATE key,
# so only the executor can decrypt them. Other processes can seal them but never open them.
# Dev: 32 random bytes, base64, different from LOCAL_MASTER_KEY: `openssl rand -base64 32`
LOCAL_WRITE_MASTER_KEY=
# Production (SECRETS_PROVIDER=kms): a different KMS key from KMS_KEY_ID. IAM: the API role
# gets only kms:Encrypt on it; only the executor role gets kms:Decrypt.
WRITE_KMS_KEY_ID=
AWS_REGION=

# ---- Google (Phase 1) ----
# OAuth client (type "Web application") from Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered on the OAuth client. Points at the API callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/google/callback
# Comma-separated client IDs accepted for "Continue with Google" sign-in (iOS, Android, web).
GOOGLE_SIGNIN_CLIENT_IDS=
# Pub/Sub topic that Gmail users.watch publishes to: projects/<project>/topics/<topic>
# Grant gmail-api-push@system.gserviceaccount.com the Publisher role on it.
GMAIL_PUBSUB_TOPIC=
# Push subscription OIDC audience (usually the push endpoint URL, <PUBLIC_GATEWAY_URL>/hooks/gmail).
GMAIL_PUBSUB_AUDIENCE=
# Service account email the push subscription signs its OIDC token as.
GMAIL_PUBSUB_SERVICE_ACCOUNT=
# 1 = use recorded fixtures instead of the real Gmail API (local demo, no Google project needed).
GMAIL_FAKE=0

# Google Workspace (Calendar, Drive, Chat) use the same Google OAuth client above.
# Calendar and Drive push to <PUBLIC_GATEWAY_URL>/hooks/gmail/channel (no extra setup).
# Chat events come through the Workspace Events API: a Pub/Sub topic with a push
# subscription to <PUBLIC_GATEWAY_URL>/hooks/gmail/events, OIDC-signed like Gmail's.
GOOGLE_EVENTS_PUBSUB_TOPIC=
GOOGLE_EVENTS_PUBSUB_AUDIENCE=

# ---- Other connectors (Phase 5) ----
# OAuth callbacks are <PUBLIC_API_URL>/oauth/<provider>/callback; webhooks go to
# <PUBLIC_GATEWAY_URL>/hooks/<provider>. Register both with each provider's app.
# 1 = every connector serves recorded fixtures (demo mode, no provider apps needed).
CONNECTORS_FAKE=0

# Microsoft 365 (Outlook, Teams, OneDrive, Calendar): Entra ID app registration,
# delegated read permissions only; Mail.Send is requested separately for sending.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# `common` for work + personal accounts, `organizations` for work only, or a tenant id.
MS_TENANT=common

# Slack: an app with user-token scopes and Event Subscriptions pointed at the gateway.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Basic Information → Signing Secret. Verifies X-Slack-Signature on every event.
SLACK_SIGNING_SECRET=

# Atlassian (Jira, Confluence): an OAuth 2.0 (3LO) app with read scopes. Webhooks are
# registered per site and signed with this client secret.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Notion: a public integration. The user picks which pages to share during consent.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Shown once when you verify the integration's webhook subscription.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# GitHub: a GitHub App with read-only Issues, Pull requests and Metadata permissions.
# The user picks repos when installing it.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---- Models (Phase 2) ----
# anthropic = real Claude models; fake = deterministic offline model for local demo and tests.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Push notifications (Phase 2) ----
# Optional Expo access token (required if "enhanced push security" is on for the project).
EXPO_ACCESS_TOKEN=
# 1 = log push notifications instead of sending them.
PUSH_FAKE=0

# ---- Mobile app (read by Expo at build time; EXPO_PUBLIC_* are bundled into the app, so no secrets) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
